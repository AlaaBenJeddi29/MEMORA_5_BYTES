# MEMORA frontend environment variables (copy to .env.local, which is git-ignored).
#
# Base URL of the Django backend API. No trailing slash.
# Leave this EMPTY for local development: the Vite dev server proxies /api and
# /media to http://127.0.0.1:8000, so the browser stays on one origin and the
# session + CSRF cookies work. Set an absolute URL only when the API lives on
# a different origin.
VITE_API_BASE_URL=
#
# Only non-secret, VITE_-prefixed values are read by the browser bundle.
# Never put API keys or passwords here — anything here ships to the client.
