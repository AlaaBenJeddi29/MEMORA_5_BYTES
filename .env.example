DJANGO_SECRET_KEY=replace-me-for-local-development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GEMINI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_REGION=

# ── Module 2: Audio & Transcription (Groq) ───────────────────────────────────
# Required for real AI results. Create a free key at https://console.groq.com/keys
# and keep it out of Git. It is read only by the Django service layer — the
# frontend never sees it. Without it every audio entry is marked failed with a
# clear message; the app never substitutes fake results.
GROQ_API_KEY=

# Models called by the service layer. These defaults are the ids Groq serves
# today; run `python manage.py test` + the smoke check if Groq renames one.
#   GROQ_ASR_MODEL → transcription (Whisper)
#   GROQ_LLM_MODEL → language detection, sentiment analysis, summarisation
GROQ_ASR_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=openai/gpt-oss-20b

# Tests and offline demos only — never true in production. Every stub it returns
# is prefixed "[Mock]" so it can never be mistaken for a real AI answer.
GROQ_MOCK=false
