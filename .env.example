DJANGO_SECRET_KEY=replace-me-for-local-development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Media library image limits: bytes and decoded pixels.
MEDIA_IMAGE_MAX_BYTES=10485760
MEDIA_IMAGE_MAX_PIXELS=40000000

# Local ComfyUI image generation. No hosted API/token is used.
# Install a Stable Diffusion checkpoint in ComfyUI and set its exact
# filename here (or export a workflow with your own checkpoint).
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=apps/media_library/workflows/stable_diffusion_1_5_text_to_image.json
COMFYUI_CHECKPOINT=
COMFYUI_TIMEOUT=180
COMFYUI_REQUEST_TIMEOUT=15

# Server-side generation guardrails. The first allowed size is the default.
MEDIA_GENERATION_MAX_PROMPT_LENGTH=1000
MEDIA_GENERATION_ALLOWED_SIZES=512x512,512x768,768x512
MEDIA_GENERATION_MIN_STEPS=1
MEDIA_GENERATION_MAX_STEPS=30
MEDIA_GENERATION_DEFAULT_STEPS=20

# Google Gemini (summaries). Server-side only: never commit a real key.
# GEMINI_MODEL must be a model your key can access; there is no universal default.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30
HF_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_REGION=

# ── Module 2: Audio & Transcription (Groq) ───────────────────────────────────
# Required for real AI results. Create a free key at https://console.groq.com/keys
# and keep it out of Git. It is read only by the Django service layer — the
# frontend never sees it. Without it every audio entry is marked failed with a
# clear message; the app never substitutes fake results.
GROQ_API_KEY=

# Models called by the service layer. These defaults are the ids Groq serves
# today; run `python manage.py test` + the smoke check if Groq renames one.
#   GROQ_ASR_MODEL → transcription (Whisper)
#   GROQ_LLM_MODEL → language detection, sentiment analysis, summarisation
GROQ_ASR_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=openai/gpt-oss-20b

# Tests and offline demos only — never true in production. Every stub it returns
# is prefixed "[Mock]" so it can never be mistaken for a real AI answer.
GROQ_MOCK=false
